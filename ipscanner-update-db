#!/usr/bin/env python3
"""
Download and compile the local IEEE vendor database used by ipscanner.
"""

import csv
import json
import re
import sys
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.9.1"
DATA_DIR = Path.home() / ".local" / "share" / "ipscanner"
DB_PATH = DATA_DIR / "vendors.json"

SOURCES = [
    ("6", "MA-L", "https://standards-oui.ieee.org/oui/oui.csv"),
    ("7", "MA-M", "https://standards-oui.ieee.org/oui28/mam.csv"),
    ("9", "MA-S", "https://standards-oui.ieee.org/oui36/oui36.csv"),
]


def clean_name(name):
    cleaned = re.sub(r"\s+", " ", (name or "").strip())
    return cleaned or "Private"


def fetch_rows(url):
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"ipscanner/{VERSION} (+local IEEE OUI updater)",
            "Accept": "text/csv,*/*",
        },
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        for row in csv.DictReader(
            (line.decode("utf-8", errors="replace") for line in response)
        ):
            yield row


def should_replace(old_name, new_name):
    if not old_name:
        return True
    if old_name.lower() == "private" and new_name.lower() != "private":
        return True
    return False


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--version":
        print(VERSION)
        return

    DATA_DIR.mkdir(parents=True, exist_ok=True)

    prefixes = {"6": {}, "7": {}, "9": {}}
    counts = {}

    for prefix_len, registry, url in SOURCES:
        total = 0
        for row in fetch_rows(url):
            assignment = re.sub(r"[^0-9A-Fa-f]", "", row.get("Assignment", "")).upper()
            if len(assignment) != int(prefix_len):
                continue

            name = clean_name(row.get("Organization Name"))
            existing = prefixes[prefix_len].get(assignment)
            if should_replace(existing, name):
                prefixes[prefix_len][assignment] = name
            total += 1

        counts[prefix_len] = len(prefixes[prefix_len])
        print(f"{registry}: {counts[prefix_len]} prefixes")

    payload = {
        "schema_version": 1,
        "generated_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "source_name": "IEEE Registration Authority",
        "sources": [
            {"registry": registry, "prefix_len": int(prefix_len), "url": url}
            for prefix_len, registry, url in SOURCES
        ],
        "counts": counts,
        "prefixes": prefixes,
    }

    tmp_path = DB_PATH.with_suffix(".json.tmp")
    tmp_path.write_text(
        json.dumps(payload, ensure_ascii=False, separators=(",", ":")),
        encoding="utf-8",
    )
    tmp_path.replace(DB_PATH)

    total_entries = sum(counts.values())
    print(f"DB salva em {DB_PATH}")
    print(f"Total de prefixes: {total_entries}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("Atualização cancelada.", file=sys.stderr)
        raise SystemExit(130)
