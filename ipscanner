    print(f"Gerado em: {vendor_db.get('generated_at', '?')}")
    counts = vendor_db.get("counts", {})
    print(
        "Entradas: "
        f"MA-L={counts.get('6', 0)} "
        f"MA-M={counts.get('7', 0)} "
